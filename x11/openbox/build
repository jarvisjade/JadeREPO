#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=openbox
srcdir=$PWD

build() {
    cd openbox-$pkgver
    export CFLAGS="$CFLAGS -std=gnu17"
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static \
        --with-x \
        --enable-startup-notification \
        --enable-xcursor \
        --enable-imlib2 \
        --enable-librsvg \
        --disable-session-management \
        --disable-nls
    make
}

package() {
    cd openbox-$pkgver
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/doc"
    rm -f "$pkgdir"/usr/bin/{gdm-control,gnome-panel-control,openbox-gnome-session,openbox-kde-session}
    rm -rf "$pkgdir/usr/share/gnome" "$pkgdir/usr/share/gnome-session"
    rm -f "$pkgdir"/usr/share/xsessions/openbox-{gnome,kde}.desktop
    install -m755 "$srcdir/openbox-xdg-autostart" "$pkgdir/usr/lib/openbox-xdg-autostart"
}

build
cd "$srcdir"
package
