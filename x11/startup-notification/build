#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=startup-notification
srcdir=$PWD

build() {
    cd startup-notification-$pkgver
    export CFLAGS="$CFLAGS -std=gnu17"
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static lf_cv_sane_realloc=yes
    make
}

package() {
    cd startup-notification-$pkgver
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/doc"
}

build
cd "$srcdir"
package
