#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=qt6-base
srcdir=$PWD

build() {
    cd qtbase-everywhere-src-$pkgver
    cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc -DBUILD_TESTING=OFF \
        -DINSTALL_BINDIR=lib/qt6/bin \
        -DINSTALL_PUBLICBINDIR=usr/bin \
        -DINSTALL_LIBEXECDIR=lib/qt6 \
        -DINSTALL_DOCDIR=share/doc/qt6 \
        -DINSTALL_ARCHDATADIR=lib/qt6 \
        -DINSTALL_DATADIR=share/qt6 \
        -DINSTALL_INCLUDEDIR=include/qt6 \
        -DINSTALL_MKSPECSDIR=lib/qt6/mkspecs \
        -DINSTALL_EXAMPLESDIR=share/doc/qt6/examples \
        -DQT_BUILD_EXAMPLES=OFF \
        -DQT_BUILD_TESTS=OFF \
        -DBUILD_WITH_PCH=OFF \
        -DINPUT_opengl=desktop \
        -DFEATURE_openssl_linked=ON \
        -DFEATURE_system_doubleconversion=OFF \
        -DFEATURE_system_harfbuzz=ON \
        -DFEATURE_system_freetype=ON \
        -DFEATURE_system_pcre2=ON \
        -DFEATURE_system_zlib=ON \
        -DFEATURE_system_png=ON \
        -DFEATURE_system_jpeg=ON \
        -DFEATURE_xcb=ON \
        -DFEATURE_xcb_xlib=ON \
        -DFEATURE_glib=ON \
        -DFEATURE_dbus_linked=ON \
        -DFEATURE_icu=OFF \
        -DFEATURE_sql=OFF \
        -DFEATURE_vulkan=OFF \
        -DFEATURE_eglfs=OFF \
        -DFEATURE_linuxfb=OFF \
        -DFEATURE_libinput=OFF \
        -DFEATURE_journald=OFF \
        -DFEATURE_gtk3=OFF \
        -DFEATURE_cups=OFF \
        -DFEATURE_brotli=OFF \
        -DFEATURE_libproxy=OFF \
        -DFEATURE_gssapi=OFF \
        -DFEATURE_mtdev=OFF \
        -DFEATURE_tslib=OFF
    cmake --build build
}

package() {
    cd qtbase-everywhere-src-$pkgver
    DESTDIR="$pkgdir" cmake --install build
    rm -rf "$pkgdir/usr/share/doc"
    sed -i '/^set(QT_SOURCE_TREE /,+1d' "$pkgdir/usr/lib/cmake/Qt6BuildInternals/QtBuildInternalsExtra.cmake"
}

build
cd "$srcdir"
package
