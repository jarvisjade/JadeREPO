#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=polkit-qt6
srcdir=$PWD

build() {
    cd polkit-qt-1-$pkgver
    cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc -DBUILD_TESTING=OFF -DQT_MAJOR_VERSION=6 -DBUILD_EXAMPLES=OFF
    cmake --build build
}

package() {
    cd polkit-qt-1-$pkgver
    DESTDIR="$pkgdir" cmake --install build
}

build
cd "$srcdir"
package
