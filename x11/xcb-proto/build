#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=xcb-proto
srcdir=$PWD

build() {
    cd xcb-proto-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static \
        PYTHON=python3
    make
}

package() {
    cd xcb-proto-$pkgver
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/doc"
}

build
cd "$srcdir"
package
