#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=xorg-xinit
srcdir=$PWD

build() {
    cd xinit-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static \
        --with-xinitdir=/etc/X11/xinit
    make
}

package() {
    cd xinit-$pkgver
    make DESTDIR="$pkgdir" install
}

build
cd "$srcdir"
package
