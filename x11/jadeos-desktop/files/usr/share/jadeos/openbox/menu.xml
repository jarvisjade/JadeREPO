<?xml version="1.0" encoding="UTF-8"?>
<!-- JadeOS Openbox root menu (right click on the desktop). Installed as
     /etc/xdg/openbox/menu.xml; copy it to ~/.config/openbox/menu.xml to
     change it for one user. -->
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="JadeOS">
    <item label="Terminal">
      <action name="Execute"><command>alacritty</command></action>
    </item>
    <item label="Applications">
      <action name="Execute"><command>jadeos-launcher</command></action>
    </item>
    <item label="Files">
      <action name="Execute"><command>pcmanfm</command></action>
    </item>
    <item label="Wi-Fi Networks">
      <action name="Execute"><command>jadeos-wifi --menu</command></action>
    </item>
    <separator />
    <item label="Reconfigure Openbox">
      <action name="Reconfigure" />
    </item>
    <separator />
    <item label="Log Out">
      <action name="Exit"><prompt>no</prompt></action>
    </item>
    <item label="Reboot">
      <action name="Execute"><command>loginctl reboot</command></action>
    </item>
    <item label="Power Off">
      <action name="Execute"><command>loginctl poweroff</command></action>
    </item>
  </menu>
</openbox_menu>
