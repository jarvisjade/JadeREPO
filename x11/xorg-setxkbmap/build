#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=xorg-setxkbmap
srcdir=$PWD

build() {
    cd setxkbmap-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static \
        --with-xkb-config-root=/usr/share/X11/xkb
    make
}

package() {
    cd setxkbmap-$pkgver
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/doc"
}

build
cd "$srcdir"
package
