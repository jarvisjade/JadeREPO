#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=xtrans
srcdir=$PWD

build() {
    cd xtrans-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static --disable-docs --without-xmlto --without-fop
    make
}

package() {
    cd xtrans-$pkgver
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/doc"
}

build
cd "$srcdir"
package
