#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=xcb-util-wm
srcdir=$PWD

build() {
    cd xcb-util-wm-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static \
        --disable-devel-docs \
        --without-doxygen
    make
}

package() {
    cd xcb-util-wm-$pkgver
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/doc"
}

build
cd "$srcdir"
package
