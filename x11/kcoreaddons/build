#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=kcoreaddons
srcdir=$PWD

build() {
    cd kcoreaddons-$pkgver
    cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc -DBUILD_TESTING=OFF \
        -DKDE_INSTALL_LIBDIR=lib \
        -DKDE_INSTALL_LIBEXECDIR=lib \
        -DBUILD_QCH=OFF \
        -DENABLE_PCH=OFF \
        -DKCOREADDONS_USE_QML=OFF \
        -DBUILD_PYTHON_BINDINGS=OFF
    cmake --build build
}

package() {
    cd kcoreaddons-$pkgver
    DESTDIR="$pkgdir" cmake --install build
}

build
cd "$srcdir"
package
