#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=ttf-dejavu
srcdir=$PWD

package() {
    cd dejavu-fonts-ttf-$pkgver
    install -d "$pkgdir/usr/share/fonts/TTF" "$pkgdir/usr/share/fontconfig/conf.avail" "$pkgdir/etc/fonts/conf.d"
    install -m644 ttf/*.ttf "$pkgdir/usr/share/fonts/TTF/"
    install -m644 fontconfig/*.conf "$pkgdir/usr/share/fontconfig/conf.avail/"
    local conf
    for conf in fontconfig/*.conf; do
        ln -s "/usr/share/fontconfig/conf.avail/${conf##*/}" "$pkgdir/etc/fonts/conf.d/${conf##*/}"
    done
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

cd "$srcdir"
package
