#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=libevdev
srcdir=$PWD

build() {
    cd libevdev-$pkgver
    meson setup build --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=lib --libexecdir=lib --sbindir=bin --buildtype=plain --wrap-mode=nofallback \
        -Dtests=disabled \
        -Dtools=disabled \
        -Ddocumentation=disabled
    meson compile -C build
}

package() {
    cd libevdev-$pkgver
    meson install -C build --destdir "$pkgdir"
}

build
cd "$srcdir"
package
