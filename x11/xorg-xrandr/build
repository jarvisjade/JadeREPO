#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=xorg-xrandr
srcdir=$PWD

build() {
    cd xrandr-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static
    make
}

package() {
    cd xrandr-$pkgver
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/doc"
    rm -f "$pkgdir/usr/bin/xkeystone"
}

build
cd "$srcdir"
package
