#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=xf86-input-libinput
srcdir=$PWD

build() {
    cd xf86-input-libinput-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static \
        --with-xorg-module-dir=/usr/lib/xorg/modules \
        --with-xorg-conf-dir=/usr/share/X11/xorg.conf.d
    make
}

package() {
    cd xf86-input-libinput-$pkgver
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/doc"
}

build
cd "$srcdir"
package
