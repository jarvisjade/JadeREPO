#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=adwaita-icon-theme
srcdir=$PWD

build() {
    cd adwaita-icon-theme-$pkgver
    meson setup build --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=lib --libexecdir=lib --sbindir=bin --buildtype=plain --wrap-mode=nofallback
    meson compile -C build
}

package() {
    cd adwaita-icon-theme-$pkgver
    meson install -C build --destdir "$pkgdir"
}

build
cd "$srcdir"
package
