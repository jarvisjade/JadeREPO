#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=popt
srcdir=$PWD

build() {
    cd popt-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static --disable-nls
    make
}

package() {
    cd popt-$pkgver
    make DESTDIR="$pkgdir" install
}

build
cd "$srcdir"
package
