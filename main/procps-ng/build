#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=procps-ng
srcdir=$PWD

build() {
    cd procps-v$pkgver
    ./autogen.sh
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static --disable-nls --disable-kill --without-systemd --disable-w \
        ac_cv_func_malloc_0_nonnull=yes ac_cv_func_realloc_0_nonnull=yes
    make
}

package() {
    cd procps-v$pkgver
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/doc"
}

build
cd "$srcdir"
package
