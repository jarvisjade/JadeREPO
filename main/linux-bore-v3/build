#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=linux-bore-v3
srcdir=$PWD

cpu_level=x86-64-v3
kernel_opt_level=3
localversion=-bore-jade-v3

build() {
    source "$srcdir/kernel/linux-bore-build.sh"
    kernel_build
}

package() {
    source "$srcdir/kernel/linux-bore-build.sh"
    kernel_package
}

build
cd "$srcdir"
package
