# JadeOS kernel: power management, CPU frequency, firmware interfaces and
# the platform drivers of common laptops (Lenovo, HP, Dell, ASUS, Acer,
# Apple, MSI, Samsung, Framework, Microsoft Surface, Valve Steam Deck).

CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_PM_SLEEP=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_INTEL_IDLE=y

CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_VIDEO=m
CONFIG_ACPI_WMI=m
CONFIG_ACPI_TAD=m
CONFIG_ACPI_PLATFORM_PROFILE=y
CONFIG_ACPI_EC=y
CONFIG_WMI_BMOF=m

# IOMMUs (also needed for Thunderbolt DMA protection) and Intel VMD, which
# hides the NVMe disks of many current laptops behind a RAID controller.
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
CONFIG_IRQ_REMAP=y
CONFIG_VMD=y

# Thermal and sensors.
CONFIG_THERMAL=y
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_INTEL_POWERCLAMP=m
CONFIG_INT340X_THERMAL=m
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_SENSORS_NCT6775=m
CONFIG_SENSORS_IT87=m
CONFIG_SENSORS_ASUS_EC=m
CONFIG_SENSORS_DELL_SMM=m
CONFIG_SENSORS_DRIVETEMP=m
CONFIG_SENSORS_ACPI_POWER=m

# Laptop and desktop platform drivers (hotkeys, backlight, fans,
# battery thresholds, platform profiles).
CONFIG_IIO=m
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
CONFIG_DELL_SMBIOS=m
CONFIG_X86_PLATFORM_DRIVERS_HP=y
CONFIG_THINKPAD_ACPI=m
CONFIG_IDEAPAD_LAPTOP=m
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
CONFIG_DELL_LAPTOP=m
CONFIG_DELL_WMI=m
CONFIG_HP_WMI=m
CONFIG_ACER_WMI=m
CONFIG_MSI_WMI=m
CONFIG_MSI_LAPTOP=m
CONFIG_SAMSUNG_LAPTOP=m
CONFIG_LG_LAPTOP=m
CONFIG_HUAWEI_WMI=m
CONFIG_ACPI_TOSHIBA=m
CONFIG_TOSHIBA_WMI=m
CONFIG_TOSHIBA_HAPS=m
CONFIG_TOSHIBA_BT_RFKILL=m
CONFIG_FUJITSU_LAPTOP=m
CONFIG_SONY_LAPTOP=m
CONFIG_GIGABYTE_WMI=m
CONFIG_APPLE_GMUX=m
CONFIG_SENSORS_APPLESMC=m
CONFIG_INTEL_HID_EVENT=m
CONFIG_INTEL_VBTN=m
CONFIG_INTEL_VSEC=m
CONFIG_INTEL_PMT_TELEMETRY=m
CONFIG_INTEL_PMC_CORE=m
CONFIG_AMD_PMC=m
CONFIG_CRYPTO_DEV_CCP=y
CONFIG_CRYPTO_DEV_CCP_DD=m
CONFIG_CRYPTO_DEV_SP_PSP=y
CONFIG_TEE=m
CONFIG_AMDTEE=m
CONFIG_AMD_PMF=m
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_SURFACE_PLATFORMS=y
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m
CONFIG_SURFACE_HID=m
CONFIG_SURFACE_ACPI_NOTIFY=m
CONFIG_CHROME_PLATFORMS=y
CONFIG_CROS_EC=m
CONFIG_CROS_EC_LPC=m

# Low-power I2C/GPIO/SPI controllers behind touchpads, touchscreens,
# sensor hubs and laptop amplifiers (without them many touchpads are dead).
# The Steam Deck needs no platform driver of its own upstream (HID_STEAM,
# amdgpu, AMD ACP and its Wi-Fi drivers cover it).
CONFIG_GPIOLIB=y
CONFIG_PINCTRL=y
CONFIG_COMMON_CLK=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_PXA2XX=m
CONFIG_SPI_MEM=y
CONFIG_SPI_AMD=m
CONFIG_PINCTRL_AMD=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_PINCTRL_LYNXPOINT=m
CONFIG_PINCTRL_BROXTON=m
CONFIG_PINCTRL_CANNONLAKE=m
CONFIG_PINCTRL_GEMINILAKE=m
CONFIG_PINCTRL_ICELAKE=m
CONFIG_PINCTRL_JASPERLAKE=m
CONFIG_PINCTRL_TIGERLAKE=m
CONFIG_PINCTRL_ALDERLAKE=m
CONFIG_PINCTRL_METEORLAKE=m
CONFIG_PINCTRL_SUNRISEPOINT=m
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_I2C_DESIGNWARE_PCI=m
CONFIG_I2C_I801=m
CONFIG_I2C_PIIX4=m
CONFIG_I2C_HID_ACPI=m
CONFIG_INTEL_ISH_HID=m
CONFIG_AMD_SFH_HID=m

# Firmware TPM (disk encryption, measured boot), RTC.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=m
CONFIG_TCG_CRB=m
CONFIG_RTC_DRV_CMOS=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
