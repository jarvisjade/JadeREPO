#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=grep
srcdir=$PWD

build() {
    cd grep-3.12
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static --disable-nls --without-included-regex
    make
}

package() {
    cd grep-3.12
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/info" "$pkgdir/usr/share/doc"
}

build
cd "$srcdir"
package
