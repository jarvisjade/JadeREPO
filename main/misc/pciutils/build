#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=pciutils
srcdir=$PWD

pci_make() {
    make HOST=x86_64-linux CROSS_COMPILE=" CC="$CC" AR="$AR" RANLIB="ranlib" \
        OPT="$CFLAGS" LDFLAGS="$LDFLAGS" PREFIX=/usr SBINDIR=/usr/bin SHAREDIR=/usr/share \
        IDSDIR=/usr/share/hwdata MANDIR=/usr/share/man SHARED=yes ZLIB=no DNS=no \
        LIBKMOD=yes HWDB=no "$@"
}

build() {
    cd pciutils-$pkgver
    pci_make
}

package() {
    cd pciutils-$pkgver
    pci_make DESTDIR="$pkgdir" install install-lib
    rm -f "$pkgdir/usr/bin/update-pciids" "$pkgdir/usr/share/man/man8/update-pciids.8"
}

build
cd "$srcdir"
package
