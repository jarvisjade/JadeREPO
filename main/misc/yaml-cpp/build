#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=yaml-cpp
srcdir=$PWD

build() {
    cd yaml-cpp-yaml-cpp-$pkgver
    cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_LIBEXECDIR=lib -DCMAKE_INSTALL_SYSCONFDIR=/etc -DBUILD_TESTING=OFF \
        -DYAML_BUILD_SHARED_LIBS=ON \
        -DYAML_CPP_BUILD_TESTS=OFF \
        -DYAML_CPP_BUILD_TOOLS=OFF \
        -DYAML_CPP_BUILD_CONTRIB=OFF
    cmake --build build
}

package() {
    cd yaml-cpp-yaml-cpp-$pkgver
    DESTDIR="$pkgdir" cmake --install build
}

build
cd "$srcdir"
package
