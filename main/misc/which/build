#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=which
srcdir=$PWD

build() {
    cd which-2.25
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static 
    make
}

package() {
    cd which-2.25
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/info" "$pkgdir/usr/share/doc"
}

build
cd "$srcdir"
package
