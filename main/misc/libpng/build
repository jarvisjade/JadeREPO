#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=libpng
srcdir=$PWD

build() {
    cd libpng-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static --enable-hardware-optimizations
    make
}

package() {
    cd libpng-$pkgver
    make DESTDIR="$pkgdir" install
}

build
cd "$srcdir"
package
