#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=squashfs-tools
srcdir=$PWD

build() {
    cd squashfs-tools-$pkgver/squashfs-tools
    make CC="$CC" XZ_SUPPORT=1 ZSTD_SUPPORT=1 LZO_SUPPORT=0 LZ4_SUPPORT=0 GZIP_SUPPORT=1 \
        XATTR_SUPPORT=1 COMP_DEFAULT=zstd
}

package() {
    cd squashfs-tools-$pkgver/squashfs-tools
    make INSTALL_PREFIX=/usr INSTALL_DIR="$pkgdir/usr/bin" INSTALL_MANPAGES_DIR= install
}

build
cd "$srcdir"
package
