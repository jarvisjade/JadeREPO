#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=dosfstools
srcdir=$PWD

build() {
    cd dosfstools-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static --enable-compat-symlinks --without-udev
    make
}

package() {
    cd dosfstools-$pkgver
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/doc"
}

build
cd "$srcdir"
package
