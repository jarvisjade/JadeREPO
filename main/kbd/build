#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=kbd
srcdir=$PWD

build() {
    cd kbd-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static --disable-nls --disable-vlock --disable-tests \
        --disable-xkb
    make
}

package() {
    cd kbd-$pkgver
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/doc"
}

build
cd "$srcdir"
package
