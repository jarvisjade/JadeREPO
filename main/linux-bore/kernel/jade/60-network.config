# JadeOS kernel: networking. Drivers chosen from the Linux hardware
# census (linux-hardware.org, Dec 2025: kernel/jade/README): Realtek and
# Intel are ~85% of Ethernet; Intel, Realtek, MediaTek, Qualcomm Atheros
# and Broadcom are ~95% of Wi-Fi. USB adapters, phone tethering and
# mobile broadband are included.

# Network stack, VPN, bridges and containers, firewall (nftables and the
# iptables compatibility used by container tools), queueing.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_WIREGUARD=m
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_VXLAN=m
CONFIG_BONDING=m
CONFIG_VLAN_8021Q=m
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
CONFIG_NETFILTER_XTABLES=m
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_NET_SCH_FQ=m
CONFIG_NET_SCH_CAKE=m
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_TCP_CONG_BBR=m

# Wired: Realtek (RTL8111/8168, RTL8125 2.5G, RTL8126 5G, RTL810x),
# Intel (e1000 in VMs, e1000e/I219, I211, I225/I226, 10G X5xx),
# Qualcomm Atheros/Killer, Broadcom, Marvell, Aquantia, NVIDIA nForce.
CONFIG_ETHERNET=y
CONFIG_R8169=m
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_IXGBE=m
CONFIG_ALX=m
CONFIG_ATL1C=m
CONFIG_TIGON3=m
CONFIG_SKY2=m
CONFIG_AQTION=m
CONFIG_FORCEDETH=m

# USB Ethernet adapters and docks (Realtek RTL8153/8156, ASIX AX88179,
# Microchip), phone tethering (Android RNDIS/NCM, iPhone), mobile
# broadband modems (MBIM, QMI).
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_LAN78XX=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_IPHETH=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_QMI_WWAN=m

# Wi-Fi.
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_RTW88=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8814AE=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW88_8723DU=m
CONFIG_RTW88_8821AU=m
CONFIG_RTW88_8812AU=m
CONFIG_RTW88_8814AU=m
CONFIG_RTW89=m
CONFIG_RTW89_8851BE=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852BTE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8922AE=m
CONFIG_RTW89_8851BU=m
CONFIG_RTW89_8852AU=m
CONFIG_RTW89_8852BU=m
CONFIG_RTW89_8852CU=m
CONFIG_RTW89_8922AU=m
CONFIG_RTL_CARDS=m
CONFIG_RTL8192CE=m
CONFIG_RTL8723AE=m
CONFIG_RTL8723BE=m
CONFIG_RTL8188EE=m
CONFIG_RTL8192EE=m
CONFIG_RTL8821AE=m
CONFIG_RTL8192CU=m
CONFIG_RTL8XXXU=m
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_MT7925E=m
CONFIG_MT7925U=m
CONFIG_MT7615E=m
CONFIG_MT7663U=m
CONFIG_MT76x2U=m
CONFIG_MT76x0U=m
CONFIG_MT7601U=m
CONFIG_ATH9K=m
CONFIG_ATH9K_PCI=y
CONFIG_ATH9K_HTC=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMFMAC_USB=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMSMAC=m
CONFIG_B43=m
CONFIG_RT2X00=m
CONFIG_RT2800PCI=m
CONFIG_RT2800USB=m
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_PCIE=m

# Bluetooth: USB adapters and the Bluetooth half of combo cards (Intel,
# Realtek, MediaTek, Qualcomm, Broadcom, CSR dongles).
CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_INTEL=y
CONFIG_BT_HCIUART_QCA=y

# Older laptops and desktops (about 2004-2010, the Core 2 / Athlon 64 era,
# which the plain x86-64 build runs on): Atheros AR5xxx, Intel PRO/Wireless
# 2100/2200 and 3945/4965, Broadcom (b43 needs Broadcom's firmware, which
# linux-firmware does not carry), Ralink, Realtek and ZyDAS cards and USB
# sticks.
CONFIG_ATH5K=m
CONFIG_ATH5K_PCI=y
CONFIG_AR5523=m
CONFIG_CARL9170=m
CONFIG_IWLEGACY=m
CONFIG_IWL3945=m
CONFIG_IWL4965=m
CONFIG_IPW2100=m
CONFIG_IPW2200=m
CONFIG_B43LEGACY=m
CONFIG_RT2400PCI=m
CONFIG_RT2500PCI=m
CONFIG_RT61PCI=m
CONFIG_RT2500USB=m
CONFIG_RT73USB=m
CONFIG_RTL8180=m
CONFIG_RTL8187=m
CONFIG_RTL8192SE=m
CONFIG_RTL8192DE=m
CONFIG_ZD1211RW=m
CONFIG_P54_COMMON=m
CONFIG_P54_USB=m
CONFIG_P54_PCI=m

# Ethernet of the same era: Atheros L1/L1e/L2 and JMicron (common in
# Acer, ASUS and MSI laptops), Broadcom 4401, Realtek 8139, VIA, SiS,
# Intel PRO/100, AMD PCnet (also VirtualBox and VMware), old USB adapters.
CONFIG_ATL1=m
CONFIG_ATL1E=m
CONFIG_ATL2=m
CONFIG_JME=m
CONFIG_B44=m
CONFIG_8139TOO=m
CONFIG_8139CP=m
CONFIG_VIA_RHINE=m
CONFIG_VIA_VELOCITY=m
CONFIG_SIS900=m
CONFIG_SIS190=m
CONFIG_E100=m
CONFIG_PCNET32=m
CONFIG_USB_PEGASUS=m
CONFIG_USB_RTL8150=m
CONFIG_USB_NET_MCS7830=m

# Virtual Wi-Fi radios, for testing Wi-Fi tools without hardware.
CONFIG_MAC80211_HWSIM=m
