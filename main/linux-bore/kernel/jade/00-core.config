# JadeOS kernel: core system. Merged on top of the kernel's own
# arch/x86/configs/x86_64_defconfig (see kernel/jade/README).

# Scheduling: BORE on a 1000 Hz tick, full preemption chosen at boot
# (preempt=), autogroups for desktop responsiveness.
CONFIG_SCHED_BORE=y
CONFIG_HZ_1000=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SCHED_AUTOGROUP=y

# Processors: up to 512 threads (workstation CPUs), NUMA, 32-bit programs
# (Steam, Wine).
CONFIG_SMP=y
CONFIG_NR_CPUS=512
CONFIG_NUMA=y
CONFIG_X86_X2APIC=y
CONFIG_IA32_EMULATION=y
CONFIG_X86_MSR=m
CONFIG_X86_CPUID=m
CONFIG_MICROCODE=y

# Memory: multi-gen LRU, transparent huge pages on request, zram/zswap.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_ZSWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=m

# Modules: zstd-compressed (kmod reads them), unloadable. Not signed:
# JadeOS does not enforce module signatures.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_SIG=n

# Boot: EFI stub and the initramfs (zstd), devtmpfs for udev.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=m
CONFIG_UNIX98_PTYS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MAGIC_SYSRQ=y

# Interfaces used by udev, elogind, OpenRC and desktop programs.
CONFIG_FHANDLE=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_EPOLL=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_IO_URING=y
CONFIG_PSI=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y

# Control groups (cgroup v2: elogind, containers) and namespaces.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_MISC=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_TIME_NS=y

# Security: Landlock and Yama, no SELinux (JadeOS ships no policy).
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_SELINUX=n
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y

# No debug information: it multiplies build time and size and JadeOS
# ships no kernel debug packages.
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_BTF=n
CONFIG_FUNCTION_TRACER=n
