# JadeOS kernel: graphics. Intel (i915 for Gen 2-12, xe for Arc and Xe2+),
# AMD (amdgpu, radeon for pre-GCN cards), NVIDIA (nouveau; the proprietary
# driver is not part of the kernel), server/remote consoles found on some
# boards, and the virtual GPUs of QEMU, VirtualBox, VMware and Hyper-V.
# simpledrm keeps the firmware framebuffer until the real driver loads.

CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_FB=y
CONFIG_VGA_SWITCHEROO=y

CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_AMD_DC=y
CONFIG_HSA_AMD=y
CONFIG_DRM_RADEON=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_AST=m
CONFIG_DRM_MGAG200=m

CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_BOCHS=m
CONFIG_DRM_QXL=m
CONFIG_DRM_CIRRUS_QEMU=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_VBOXVIDEO=m
CONFIG_DRM_HYPERV=m

# Intel and AMD neural processing units (current laptops).
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_IVPU=m
CONFIG_DRM_ACCEL_AMDXDNA=m
