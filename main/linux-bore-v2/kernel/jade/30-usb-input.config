# JadeOS kernel: USB, Thunderbolt/USB4, keyboards, mice, touchpads,
# game controllers and USB serial adapters. Host controllers and generic
# HID are built in so the keyboard works in the initramfs.

CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB4=m
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m
CONFIG_TYPEC_DP_ALTMODE=m
CONFIG_USB_ROLE_SWITCH=m
CONFIG_USB_PRINTER=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_OPTION=m

# HID: generic, I2C touchpads/touchscreens, sensor hubs, and the vendor
# drivers for common keyboards, mice and controllers.
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=m
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_I2C_HID=m
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_SENSOR_HUB=m
CONFIG_HID_SENSOR_ACCEL_3D=m
CONFIG_HID_SENSOR_ALS=m
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_HID_APPLE=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_LENOVO=m
CONFIG_HID_ASUS=m
CONFIG_HID_CHERRY=m
CONFIG_HID_CORSAIR=m
CONFIG_HID_STEELSERIES=m
CONFIG_HID_ALPS=m
CONFIG_HID_WACOM=m
CONFIG_HID_SONY=m
CONFIG_SONY_FF=y
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_NINTENDO=m
CONFIG_HID_STEAM=m
CONFIG_HID_HYPERV_MOUSE=m

# Built-in keyboards and touchpads (PS/2, Synaptics/Elan over SMBus).
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_UINPUT=m
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_SMBUS=y
CONFIG_MOUSE_PS2_VMMOUSE=y
CONFIG_MOUSE_ELAN_I2C=m
CONFIG_MOUSE_ELAN_I2C_SMBUS=y
CONFIG_RMI4_CORE=m
CONFIG_RMI4_SMB=m
CONFIG_MOUSE_BCM5974=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
