#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=linux-pam
srcdir=$PWD

build() {
    cd Linux-PAM-$pkgver
    meson setup build --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=lib --libexecdir=lib --sbindir=bin --buildtype=plain --wrap-mode=nofallback \
        -Ddocs=disabled \
        -Dexamples=false \
        -Dnis=disabled \
        -Daudit=disabled \
        -Dselinux=disabled \
        -Deconf=disabled \
        -Dlogind=disabled \
        -Delogind=disabled \
        -Dxtests=false \
        -Di18n=disabled \
        -Dsecuredir=/usr/lib/security
    meson compile -C build
}

package() {
    cd Linux-PAM-$pkgver
    meson install -C build --destdir "$pkgdir"
    install -d -m755 "$pkgdir/etc/pam.d"
    install -m644 "$srcdir"/pam.d/* "$pkgdir/etc/pam.d/"
    chmod 4755 "$pkgdir/usr/bin/unix_chkpwd" 2>/dev/null || true
    rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/lib/systemd"
}

build
cd "$srcdir"
package
