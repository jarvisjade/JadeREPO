# Gemstone repositories: <name> <location> [path=<subdirectory>] [ref=<branch>]
#
# A location is a git URL (git+https://... or ending in .git), an HTTPS
# archive (.tar.gz, .tar.xz, .tar.zst) or a local directory. A name listed
# again adds a fallback location. When two repositories have a recipe of the
# same name, the one listed first wins. Add your own with
# "gemstone lode add <name> <location>".

main                 git+https://github.com/jarvisjade/JadeREPO.git  path=main
misc                 git+https://github.com/jarvisjade/JadeREPO.git  path=main/misc
x11                  git+https://github.com/jarvisjade/JadeREPO.git  path=x11
binary               git+https://github.com/jarvisjade/JadeREPO.git  path=binary
