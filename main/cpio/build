#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=cpio
srcdir=$PWD

build() {
    cd cpio-$pkgver
    CFLAGS="$CFLAGS -std=gnu17" ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static --disable-nls --disable-mt
    make
}

package() {
    cd cpio-$pkgver
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/info"
    rm -f "$pkgdir/usr/lib/rmt" "$pkgdir/usr/share/man/man8/rmt.8"
}

build
cd "$srcdir"
package
