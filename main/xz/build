#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=xz
srcdir=$PWD

build() {
    cd xz-$pkgver
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static --disable-doc --disable-nls
    make
}

package() {
    cd xz-$pkgver
    make DESTDIR="$pkgdir" install
}

build
cd "$srcdir"
package
