#!/bin/bash -e

pkgdir=$1
pkgver=$2
pkgname=gawk
srcdir=$PWD

build() {
    cd gawk-5.4.1
    ./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libdir=/usr/lib --libexecdir=/usr/lib --sbindir=/usr/bin --disable-static --disable-nls --without-libsigsegv-prefix
    make
}

package() {
    cd gawk-5.4.1
    make DESTDIR="$pkgdir" install
    rm -rf "$pkgdir/usr/share/info" "$pkgdir/usr/share/doc"
    rm -f "$pkgdir/usr/bin/gawk-"*; rm -rf "$pkgdir/usr/lib/gawk" "$pkgdir/usr/share/awk"
}

build
cd "$srcdir"
package
